{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "useDefineForClassFields": false,
    "types": ["node"],

    "sourceMap": true,
    "noEmit": false
  },

  "include": ["src/**/*.ts"],

  "references": [{ "path": "../common" }]
}
